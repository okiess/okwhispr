# Copy this file to .env.signing and fill in your own values.
# .env.signing is gitignored (via .env*), so real credentials are never committed.
#
# build.sh sources this file when it exists. It is optional: without it the build
# falls back to an auto-detected "Apple Development:" identity, then ad hoc.

# Developer ID certificate used for signing (and, with NOTARIZE=1, notarization).
# Find it in the Keychain, or run:
#   security find-identity -v -p codesigning
export DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"

# The three below are only needed for notarization (NOTARIZE=1 ./build.sh).
# APPLE_APP_PASSWORD is an app-specific password from your Apple account, not your
# account password.
export APPLE_ID="you@example.com"
export APPLE_TEAM_ID="TEAMID"
export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
